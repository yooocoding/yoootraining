# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase Dashboard -> Project Settings -> API Keys
#
# Keep THIS file's values empty — it is committed to git. Real values go in
# .env.local, which is gitignored.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret (service role) key — SERVER ONLY, never expose to the browser.
# Bypasses RLS; used by the Next.js API routes.
SUPABASE_SECRET_KEY=
